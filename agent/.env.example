# aiping.cn OpenAI 兼容网关
LLM_BASE_URL=https://aiping.cn/api/v1
LLM_API_KEY=your-api-key
LLM_MODEL=Qwen2.5-7B-Instruct
PORT=4111
# 目标链: sepolia(默认) | fuji; CHAIN_RPC / DID_IDENTITY_ADDRESS 可覆盖该链默认值
TARGET_CHAIN=sepolia
# Agent 服务热钱包地址:安装需要 social 权限的技能时查链上 agentPermissions;留空则跳过校验
AGENT_SERVICE_ADDRESS=
# M3 心跳调度器周期(秒),默认 300
HEARTBEAT_SECONDS=300
# M4 DeFi 热钱包私钥(只放少量测试币;未配置时 defi-swap 不可用)。永远不要提交真实值
AGENT_PRIVATE_KEY=
# 价格源(熔断测试时可故意改错)
PRICE_COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price?ids=avalanche-2&vs_currencies=usd
PRICE_GATE_URL=https://api.gateio.ws/api/v4/spot/tickers?currency_pair=AVAX_USDT
# 策略引擎阈值:单笔限额(USD)/日累计限额(USD)/同 action 冷却(秒)
POLICY_MAX_TX_USD=25
POLICY_DAILY_LIMIT_USD=125
POLICY_COOLDOWN_SECONDS=600
# 数据目录覆盖(多实例并行/验证用),默认 agent/data
AGENT_DATA_DIR=
