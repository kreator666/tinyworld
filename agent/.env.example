# aiping.cn OpenAI 兼容网关
LLM_BASE_URL=https://aiping.cn/api/v1
LLM_API_KEY=your-api-key
LLM_MODEL=Qwen2.5-7B-Instruct
PORT=4111
# 目标链: sepolia | fuji(默认 fuji); CHAIN_RPC / DID_IDENTITY_ADDRESS 可覆盖该链默认值
TARGET_CHAIN=fuji
# Agent 服务热钱包地址:安装需要 social 权限的技能时查链上 agentPermissions;留空则跳过校验
AGENT_SERVICE_ADDRESS=
